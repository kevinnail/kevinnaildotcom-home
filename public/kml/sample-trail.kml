<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sample Trail — Cascade Ridge</name>
    <description>Placeholder hike for slice 4. Real hikes are uploaded in slice 5.</description>

    <Style id="trailLine">
      <LineStyle>
        <color>ff00aaff</color>
        <width>4</width>
      </LineStyle>
    </Style>

    <Placemark>
      <name>Trailhead</name>
      <description>Start of the sample trail.</description>
      <Point>
        <coordinates>-121.760000,46.852000,1650</coordinates>
      </Point>
    </Placemark>

    <Placemark>
      <name>Summit</name>
      <description>High point of the sample trail.</description>
      <Point>
        <coordinates>-121.735000,46.865000,2400</coordinates>
      </Point>
    </Placemark>

    <Placemark>
      <name>Cascade Ridge Route</name>
      <styleUrl>#trailLine</styleUrl>
      <LineString>
        <tessellate>1</tessellate>
        <coordinates>
          -121.760000,46.852000,1650
          -121.753000,46.856000,1820
          -121.747000,46.859000,2010
          -121.741000,46.862000,2230
          -121.735000,46.865000,2400
        </coordinates>
      </LineString>
    </Placemark>
  </Document>
</kml>
