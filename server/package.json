{
  "name": "kevinnaildotcom-server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node -r dotenv/config server.js",
    "dev": "node --watch -r dotenv/config server.js",
    "start:watch": "node --watch -r dotenv/config server.js",
    "setup-db": "node -r dotenv/config setup-db.js",
    "setup-test-db": "node -r dotenv/config setup-test-db.js",
    "create-admin": "node -r dotenv/config scripts/create-admin.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@aws-sdk/s3-request-presigner": "3.1085.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
