{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  // Language-specific overrides in user settings beat a bare workspace
  // editor.defaultFormatter, so pin the per-language formatter explicitly.
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "editor.formatOnSave": true,
  "prettier.prettierPath": "node_modules/prettier",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "peacock.color": "blue",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#3333ff",
    "activityBar.activeBorder": "#e7e7e7",
    "activityBar.background": "#3333ff",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#600000",
    "activityBarBadge.foreground": "#e7e7e7",
    "activityBarTop.activeBackground": "#3333ff",
    "activityBarTop.activeBorder": "#e7e7e7",
    "activityBarTop.background": "#3333ff",
    "activityBarTop.foreground": "#e7e7e7",
    "activityBarTop.inactiveForeground": "#e7e7e799",
    "commandCenter.border": "#e7e7e799",
    "commandCenter.foreground": "#e7e7e7",
    "sash.hoverBorder": "#3333ff",
    "statusBar.background": "#0000ff",
    "statusBar.debuggingBackground": "#0000ff",
    "statusBar.debuggingForeground": "#e7e7e7",
    "statusBar.foreground": "#e7e7e7",
    "statusBar.inactiveBackground": "#0000ff",
    "statusBarItem.hoverBackground": "#3333ff",
    "statusBarItem.remoteBackground": "#400000",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "titleBar.activeBackground": "#0000ff",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#0000ff99",
    "titleBar.inactiveForeground": "#e7e7e799"
  }
}
